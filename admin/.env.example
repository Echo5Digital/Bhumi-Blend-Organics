# Copy to `.env.local` if you need to change these. Both have working defaults for local development.

# Where the backend API is (backend/ — `npm run dev` there listens on 4000).
VITE_API_URL=http://localhost:4000

# Where the storefront is: used for "View on site" links and to show product photos
# that are still stored as storefront paths (like /Hair-Oil-Organic.jpg).
VITE_STOREFRONT_URL=http://localhost:3000
