# Copy this file to `.env` and fill it in. `.env` is git-ignored.

# --- Server -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Number of reverse proxies in front of the API (Render, Railway, Nginx...). 0 = none.
TRUST_PROXY=0
# Websites allowed to call the API from a browser, comma separated. The storefront also serves
# the admin panel (at /adminecho5), so this one address covers both. In production put your
# live shop address here (e.g. https://yourshop.com), plus the Vercel preview address if you use it.
CLIENT_ORIGINS=http://localhost:3000

# --- MongoDB (required) -------------------------------------------------
# Your MongoDB connection link, e.g. from MongoDB Atlas:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bhumiblend?retryWrites=true&w=majority
MONGODB_URI=

# --- Admin login (required) ---------------------------------------------
# Long random text used to sign admin login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# How long a shopper stays logged in on their device
CUSTOMER_JWT_EXPIRES_IN=30d

# --- Email / SMTP (sign-up verification codes) --------------------------
# Needs SMTP_HOST and MAIL_FROM. Without them, development prints each email's
# code in this server's console, and production refuses sign-ups (so it never
# pretends to have sent one).
SMTP_HOST=
# 587 (STARTTLS, SMTP_SECURE=false) or 465 (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. Bhumi Blend <no-reply@bhumiblend.com>
MAIL_FROM=
# Who gets the "New order" email when an order is placed (comma separated). This is only the
# default: whatever is saved in the admin (Settings > Emails > New order) wins. It needs SMTP above
# to really send; without SMTP in development the email is printed in this server's console.
ORDER_NOTIFY_EMAILS=

# --- Cloudinary (image uploads; optional until you have the keys) -------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bhumiblend

# --- Razorpay (payments; optional until you have the keys) --------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set in Razorpay dashboard > Webhooks (URL: <api>/api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=

# --- Storefront refresh (so admin edits show on the site at once) --------
# Where the storefront runs, and a shared secret (16+ characters). The SAME secret
# goes in frontend/.env.local as REVALIDATE_SECRET. Optional: without these, pages
# still pick up changes on their own within a minute.
STOREFRONT_URL=
REVALIDATE_SECRET=
